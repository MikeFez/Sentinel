# Finnhub API Configuration
# Get your free API key from https://finnhub.io
FINNHUB_API_KEY=your_api_key_here

# LLM (any OpenAI-compatible endpoint; base URL includes /v1)
LLM_BASE_URL=http://athena.lan:8090/v1
LLM_MODEL=qwen3.8:27b
# Optional; sent as "Authorization: Bearer <key>"
LLM_API_KEY=

# SEC asks automated clients for a contact ("YourName your@email") when reading filings
SEC_USER_AGENT=
# Notifications: one or more Apprise URLs (ntfy, Pushover, Discord, Telegram, email...), space-separated
# See https://github.com/caronc/apprise/wiki
NOTIFY_URLS=
# Sentinel's address, for links in notifications (optional)
SENTINEL_URL=

# Application Settings
NEWS_ARTICLE_COUNT=10
